{
    "keyboard_name": "Allien",
    "manufacturer": "Dexx",
    "url": "https://github.com/josericardodainese/TOTEM",
    "maintainer": "josericardodainese",
    "usb": {
        "vid": "0x3A3C",
        "pid": "0x0020",
        "device_version": "2.1.0"
    },
    "processor": "RP2040",
    "bootloader": "rp2040",

    "//": "Unibody 20-key macropad. No encoder, no OLED -- RGB is driven by key chords.",
    "//board": "Seeed XIAO RP2040. This variant needs only 11 GPIO, which is exactly",
    "//board2": "what the XIAO exposes -- and it matches the project schematic pin for pin.",
    "//board3": "A Waveshare RP2040-Zero also works; see readme.md for its pin mapping.",
    "//matrix": "firmware index -> schematic net -> XIAO pad:",
    "//rows": "row 0 = ROW4 (GP1/D7), row 1 = ROW3 (GP2/D8), row 2 = ROW2 (GP4/D9), row 3 = ROW1 (GP3/D10)",
    "//cols": "col 0 = COL1 (GP7/D5), COL2 (GP6/D4), COL3 (GP29/D3), COL4 (GP28/D2), COL5 (GP27/D1), COL6 (GP26/D0)",
    "matrix_pins": {
        "rows": ["GP1", "GP2", "GP4", "GP3"],
        "cols": ["GP7", "GP6", "GP29", "GP28", "GP27", "GP26"]
    },
    "diode_direction": "COL2ROW",
    "debounce": 5,

    "features": {
        "rgb_matrix": true
    },

    "//ws2812": "GP0 = pad D6 = LEDS_SIGNAL in the project schematic",
    "ws2812": {
        "pin": "GP0",
        "driver": "vendor"
    },
    "rgb_matrix": {
        "driver": "ws2812",
        "//chain": "DIN -> DOUT must follow SW1..SW20; see g_led_config in allien.c",
        "max_brightness": 120,
        "sleep": true,
        "animations": {
            "solid_color": true,
            "breathing": true,
            "hue_breathing": true,
            "cycle_all": true,
            "cycle_left_right": true,
            "cycle_up_down": true,
            "rainbow_moving_chevron": true,
            "jellybean_raindrops": true,
            "pixel_rain": true,
            "typing_heatmap": true,
            "digital_rain": true,
            "solid_reactive_simple": true,
            "solid_reactive": true,
            "splash": true,
            "solid_splash": true
        }
    },

    "layouts": {
        "LAYOUT": {
            "layout": [
                { "label": "1",      "matrix": [0, 1], "x": 2.2,  "y": 0.25 },
                { "label": "2",      "matrix": [0, 2], "x": 3.2,  "y": 0    },
                { "label": "3",      "matrix": [0, 3], "x": 4.2,  "y": 0.2  },
                { "label": "R",      "matrix": [0, 4], "x": 5.2,  "y": 0.35 },

                { "label": "Q",      "matrix": [1, 0], "x": 1.2,  "y": 1.55 },
                { "label": "A",      "matrix": [1, 1], "x": 2.2,  "y": 1.25 },
                { "label": "W",      "matrix": [1, 2], "x": 3.2,  "y": 1    },
                { "label": "D",      "matrix": [1, 3], "x": 4.2,  "y": 1.2  },
                { "label": "F",      "matrix": [1, 4], "x": 5.2,  "y": 1.35 },

                { "label": "Shift",  "matrix": [2, 0], "x": 1.2,  "y": 2.55 },
                { "label": "Z",      "matrix": [2, 1], "x": 2.2,  "y": 2.25 },
                { "label": "S",      "matrix": [2, 2], "x": 3.2,  "y": 2    },
                { "label": "X",      "matrix": [2, 3], "x": 4.2,  "y": 2.2  },
                { "label": "T",      "matrix": [2, 4], "x": 6.4,  "y": 1.7  },
                { "label": "E",      "matrix": [2, 5], "x": 7.45, "y": 2.5  },

                { "label": "G",      "matrix": [3, 0], "x": 0,    "y": 2.7  },
                { "label": "Ctrl",   "matrix": [3, 1], "x": 1.6,  "y": 3.4  },
                { "label": "C",      "matrix": [3, 3], "x": 4.2,  "y": 3.3  },
                { "label": "Space",  "matrix": [3, 4], "x": 6.4,  "y": 2.7, "h": 2 },
                { "label": "B",      "matrix": [3, 5], "x": 7.45, "y": 3.5  }
            ]
        }
    }
}
